{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "autoCompactWindow": 400000,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",

    "allow": [
      "Edit(./PLAN.md)",
      "Bash(git status*)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git -C {{CODE_DIR}} fetch*)", "Bash(git -C {{CODE_DIR}} pull --ff-only*)", "Bash(git -C {{CODE_DIR}} status*)",
      "Bash(git -C {{CODE_DIR}} log *)", "Bash(git -C {{CODE_DIR}} show *)", "Bash(git -C {{CODE_DIR}} diff *)",
      "Bash(git -C {{CODE_DIR}} ls-tree *)",
      "Bash(git -C _worktrees/build status*)", "Bash(git -C _worktrees/build diff *)", "Bash(git -C _worktrees/build log *)",
      "Bash(git -C _worktrees/build show *)", "Bash(git -C _worktrees/build ls-tree *)", "Bash(git -C _worktrees/build branch --show-current)",
      "Bash(git -C _worktrees/build add *)", "Bash(git -C _worktrees/build commit *)",
      "Bash(git -C _worktrees/build switch -c feat/*)", "Bash(git -C _worktrees/build fetch*)",
      "Bash(git -C _worktrees/build merge origin/{{MAIN_BRANCH}}*)",
      "Bash(git -C _worktrees/build push -u origin feat/*)", "Bash(git -C _worktrees/build push origin feat/*)",
      "Bash(git -C _worktrees/build worktree add --detach ../check *)", "Bash(git -C _worktrees/build worktree remove --force ../check)",
      "Bash(git -C _worktrees/check checkout feat/*)", "Bash(git -C _worktrees/check status*)",
      "PowerShell(git status*)", "PowerShell(git diff *)", "PowerShell(git log *)", "PowerShell(git show *)",
      "PowerShell(git add *)", "PowerShell(git commit *)",
      "PowerShell(git -C {{CODE_DIR}} fetch*)", "PowerShell(git -C {{CODE_DIR}} pull --ff-only*)", "PowerShell(git -C {{CODE_DIR}} status*)",
      "PowerShell(git -C {{CODE_DIR}} log *)", "PowerShell(git -C {{CODE_DIR}} show *)", "PowerShell(git -C {{CODE_DIR}} diff *)",
      "PowerShell(git -C {{CODE_DIR}} ls-tree *)",
      "PowerShell(git -C _worktrees/build status*)", "PowerShell(git -C _worktrees/build diff *)", "PowerShell(git -C _worktrees/build log *)",
      "PowerShell(git -C _worktrees/build show *)", "PowerShell(git -C _worktrees/build ls-tree *)", "PowerShell(git -C _worktrees/build branch --show-current)",
      "PowerShell(git -C _worktrees/build add *)", "PowerShell(git -C _worktrees/build commit *)",
      "PowerShell(git -C _worktrees/build switch -c feat/*)", "PowerShell(git -C _worktrees/build fetch*)",
      "PowerShell(git -C _worktrees/build merge origin/{{MAIN_BRANCH}}*)",
      "PowerShell(git -C _worktrees/build push -u origin feat/*)", "PowerShell(git -C _worktrees/build push origin feat/*)",
      "PowerShell(git -C _worktrees/build worktree add --detach ../check *)", "PowerShell(git -C _worktrees/build worktree remove --force ../check)",
      "PowerShell(git -C _worktrees/check checkout feat/*)", "PowerShell(git -C _worktrees/check status*)",

      "Bash({{TEST_COMMAND}} *)", "Bash({{FULL_TEST_COMMAND}})", "Bash({{CHECK_COMMAND}})", "Bash({{DEV_COMMAND}})",
      "PowerShell({{TEST_COMMAND}} *)", "PowerShell({{FULL_TEST_COMMAND}})", "PowerShell({{CHECK_COMMAND}})", "PowerShell({{DEV_COMMAND}})",
      "mcp__playwright",

      "Bash(gh auth status *)", "Bash(gh pr create *)", "Bash(gh pr view *)", "Bash(gh pr checks *)",
      "Bash(gh pr diff *)", "Bash(gh run list *)", "Bash(gh run view *)",
      "PowerShell(gh auth status *)", "PowerShell(gh pr create *)", "PowerShell(gh pr view *)", "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)", "PowerShell(gh run list *)", "PowerShell(gh run view *)",
      "Bash(gh api repos/{{GITHUB_REPO}}/commits/*/check-runs*)", "Bash(gh api repos/{{GITHUB_REPO}}/commits/*/statuses*)",
      "PowerShell(gh api repos/{{GITHUB_REPO}}/commits/*/check-runs*)", "PowerShell(gh api repos/{{GITHUB_REPO}}/commits/*/statuses*)"
    ],

    "ask": [
      "Agent(adversarial-reviewer)",
      "Edit(./.claude/**)", "Edit(./CLAUDE.md)", "Edit(./ORCHESTRATOR.md)",
      "WebFetch", "WebSearch",
      "Bash(gh api *-X*)", "Bash(gh api *--method*)", "Bash(gh api *-f*)", "Bash(gh api *-F*)",
      "Bash(gh api *--field*)", "Bash(gh api *--raw-field*)", "Bash(gh api *--input*)",
      "PowerShell(gh api *-X*)", "PowerShell(gh api *--method*)", "PowerShell(gh api *-f*)", "PowerShell(gh api *-F*)",
      "PowerShell(gh api *--field*)", "PowerShell(gh api *--raw-field*)", "PowerShell(gh api *--input*)",
      "Bash(npm install *)", "Bash(npm ci *)", "Bash(pnpm add *)", "Bash(yarn add *)",
      "Bash(pip install *)", "Bash(uv add *)", "Bash(poetry add *)",
      "PowerShell(npm install *)", "PowerShell(npm ci *)", "PowerShell(pnpm add *)", "PowerShell(yarn add *)",
      "PowerShell(pip install *)", "PowerShell(uv add *)", "PowerShell(poetry add *)"
    ],

    "deny": [
      "Agent(general-purpose)", "Agent(Explore)", "Agent(Plan)", "Agent(claude)",
      "Agent(claude-code-guide)", "Agent(statusline-setup)",

      "Read(**/.env)", "Read(**/.env.*)", "Edit(**/.env)", "Edit(**/.env.*)",
      "Bash(cat *.env*)", "PowerShell(Get-Content *.env*)", "PowerShell(type *.env*)",

      "Read({{SECRETS_DIR}}/**)", "Edit({{SECRETS_DIR}}/**)",
      "Bash(*{{SECRETS_DIR}}*)", "PowerShell(*{{SECRETS_DIR}}*)",

      "Read(./ops/**)", "Edit(./ops/**)",
      "Bash(ops/*)", "Bash(./ops/*)", "Bash(* ops/*)", "Bash(* ./ops/*)", "Bash(*/ops/*)", "Bash(*\\ops\\*)",
      "PowerShell(ops*)", "PowerShell(./ops*)", "PowerShell(.\\ops*)", "PowerShell(* ops*)",
      "PowerShell(* ./ops*)", "PowerShell(* .\\ops*)", "PowerShell(*/ops/*)", "PowerShell(*\\ops\\*)",

      "Bash(git push * {{MAIN_BRANCH}})", "Bash(git push * {{MAIN_BRANCH}} *)", "Bash(git push *:{{MAIN_BRANCH}}*)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * --force*)", "Bash(git push * -f *)",
      "PowerShell(git push * {{MAIN_BRANCH}})", "PowerShell(git push * {{MAIN_BRANCH}} *)", "PowerShell(git push *:{{MAIN_BRANCH}}*)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(git push * --force*)", "PowerShell(git push * -f *)",
      "Bash(git reset --hard*)", "PowerShell(git reset --hard*)",

      "Bash(git -C * push * {{MAIN_BRANCH}})", "Bash(git -C * push * {{MAIN_BRANCH}} *)", "Bash(git -C * push *:{{MAIN_BRANCH}}*)",
      "Bash(git -C * push --force*)", "Bash(git -C * push -f*)", "Bash(git -C * push * --force*)", "Bash(git -C * push * -f *)",
      "Bash(git -C * reset --hard*)", "Bash(git --git-dir*)", "Bash(git --work-tree*)",
      "PowerShell(git -C * push * {{MAIN_BRANCH}})", "PowerShell(git -C * push * {{MAIN_BRANCH}} *)", "PowerShell(git -C * push *:{{MAIN_BRANCH}}*)",
      "PowerShell(git -C * push --force*)", "PowerShell(git -C * push -f*)", "PowerShell(git -C * push * --force*)", "PowerShell(git -C * push * -f *)",
      "PowerShell(git -C * reset --hard*)", "PowerShell(git --git-dir*)", "PowerShell(git --work-tree*)",

      "Bash(gh pr merge *)", "PowerShell(gh pr merge *)",
      "Bash(gh repo delete *)", "PowerShell(gh repo delete *)",

      "Bash(*{{MIGRATION_TOOL}}*)", "PowerShell(*{{MIGRATION_TOOL}}*)",
      "Bash({{PROD_CLI}} *)", "PowerShell({{PROD_CLI}} *)",

      "Bash(*sed -i*)", "PowerShell(*sed -i*)"
    ]
  },

  "attribution": { "commit": "", "pr": "" },

  "outputStyle": "Orchestrator",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/print-now.ps1"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
