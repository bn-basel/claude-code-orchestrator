{
  "about": "Sample launches for the helper guard. root: which project the guard runs in (template = the shipped policy and agent files; repo = this repo's own policy; broken = a fixture). expect: allow | ask | deny. says: text the message must contain.",
  "hook": [
    { "name": "allowed launch, model from the agent file", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "find X", "prompt": "Where is X?" } },
      "expect": "allow" },
    { "name": "allowed launch, model and effort named", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "implementer", "description": "T1", "prompt": "Task T1", "model": "sonnet", "effort": "high" } },
      "expect": "allow" },
    { "name": "effort xhigh is fine", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "reviewer", "description": "review", "prompt": "Review", "effort": "xhigh" } },
      "expect": "allow" },
    { "name": "effort max asks the owner", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "reviewer", "description": "review", "prompt": "Review", "effort": "max" } },
      "expect": "ask", "says": "effort max" },
    { "name": "wrong model is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "find X", "prompt": "Where is X?", "model": "opus" } },
      "expect": "deny", "says": "may use haiku only" },
    { "name": "built-in helper is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "Explore", "description": "search", "prompt": "Search", "model": "haiku" } },
      "expect": "deny", "says": "not an allowed helper" },
    { "name": "no helper type means general-purpose, blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "description": "do it", "prompt": "Do it" } },
      "expect": "deny", "says": "'general-purpose' is not an allowed helper" },
    { "name": "unknown helper name is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "my-helper", "description": "x", "prompt": "x", "model": "sonnet" } },
      "expect": "deny", "says": "not an allowed helper" },
    { "name": "full model ID counts as its family", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "x", "prompt": "x", "model": "claude-haiku-5-5" } },
      "expect": "allow" },
    { "name": "full model ID of the wrong family is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "reviewer", "description": "x", "prompt": "x", "model": "claude-sonnet-5-5" } },
      "expect": "deny", "says": "may use opus only" },
    { "name": "implementer-wide on sonnet runs", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "implementer-wide", "description": "T2", "prompt": "Task T2" } },
      "expect": "allow" },
    { "name": "implementer-wide on opus asks the owner", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "implementer-wide", "description": "T2", "prompt": "Task T2", "model": "opus" } },
      "expect": "ask", "says": "on opus" },
    { "name": "every Fable review asks the owner", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "adversarial-reviewer", "description": "attack", "prompt": "Attack the plan" } },
      "expect": "ask", "says": "every 'adversarial-reviewer' run" },
    { "name": "Fable review on another model is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "adversarial-reviewer", "description": "attack", "prompt": "x", "model": "opus" } },
      "expect": "deny", "says": "may use fable only" },
    { "name": "effort that isn't a level is blocked", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "x", "prompt": "x", "effort": "ultracode" } },
      "expect": "deny", "says": "isn't allowed" },
    { "name": "env CLAUDE_CODE_EFFORT_LEVEL=max is blocked", "root": "template",
      "env": { "CLAUDE_CODE_EFFORT_LEVEL": "max" },
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "x", "prompt": "x" } },
      "expect": "deny", "says": "CLAUDE_CODE_EFFORT_LEVEL" },
    { "name": "forced env model that breaks the table is blocked", "root": "template",
      "env": { "CLAUDE_CODE_SUBAGENT_MODEL": "opus", "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1" },
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "x", "prompt": "x", "model": "haiku" } },
      "expect": "deny", "says": "forced" },
    { "name": "model text inside the prompt doesn't fool it", "root": "template",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout", "description": "x", "prompt": "Find where \"model\": \"opus\" and \"effort\": \"max\" are set." } },
      "expect": "allow" },
    { "name": "unreadable input is blocked", "root": "template",
      "raw": "{ this is not json",
      "expect": "deny", "says": "could not be read" },
    { "name": "other tools pass through", "root": "template",
      "input": { "tool_name": "Bash", "tool_input": { "command": "git status" } },
      "expect": "allow" },
    { "name": "agent file without a model, launch without a model", "root": "broken",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "no-model", "description": "x", "prompt": "x" } },
      "expect": "deny", "says": "needs a model named in the launch" },
    { "name": "agent file with effort max is blocked", "root": "broken",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "reviewer", "description": "x", "prompt": "x" } },
      "expect": "deny", "says": "its agent file sets effort max" },
    { "name": "repo: research helper with sonnet named", "root": "repo",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "claude-code-guide", "description": "docs", "prompt": "Check the docs", "model": "sonnet", "effort": "medium" } },
      "expect": "allow" },
    { "name": "repo: research helper without a model", "root": "repo",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "Explore", "description": "search", "prompt": "Search" } },
      "expect": "deny", "says": "needs a model named in the launch" },
    { "name": "repo: research helper on opus", "root": "repo",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "Explore", "description": "search", "prompt": "Search", "model": "opus" } },
      "expect": "deny", "says": "may use sonnet or haiku only" },
    { "name": "repo: other built-in helper", "root": "repo",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "general-purpose", "description": "x", "prompt": "x", "model": "sonnet" } },
      "expect": "deny", "says": "not an allowed helper" },
    { "name": "repo: research helper at effort max asks", "root": "repo",
      "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "Explore", "description": "x", "prompt": "x", "model": "haiku", "effort": "max" } },
      "expect": "ask", "says": "effort max" }
  ],
  "check": [
    { "name": "template agent files match the table", "root": "template", "expect": "pass" },
    { "name": "this repo's table (built-in rows only)", "root": "repo", "expect": "pass" },
    { "name": "broken fixture fails on every problem", "root": "broken", "expect": "fail",
      "says": [
        "scout.md: model 'opus' not allowed",
        "reviewer.md: effort 'max' not allowed",
        "no-model.md: no model",
        "stray.md: helper 'stray' has no row",
        "'orphan' has a row but no agent file"
      ] }
  ]
}
