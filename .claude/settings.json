{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "high",
  "permissions": {
    "deny": [
      "Agent(general-purpose)", "Agent(Plan)", "Agent(claude)", "Agent(statusline-setup)",
      "Workflow",
      "mcp__ccd_session_mgmt__set_session_effort", "mcp__ccd_session_mgmt__set_session_model",
      "mcp__ccd_session_mgmt__set_session_fast_mode"
    ]
  },
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/template/.claude/hooks/guard-helpers.ps1"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
